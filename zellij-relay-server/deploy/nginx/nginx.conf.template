user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    # Each active viewer holds one WebSocket connection — size for
    # expected peak.
    worker_connections 4096;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    'rt=$request_time uct="$upstream_connect_time"';

    access_log  /var/log/nginx/access.log main;

    sendfile        on;
    keepalive_timeout 65;

    # Phase 6 §Nginx Requirements: all HTTP traffic is small (handshake
    # JSON + auth) — actual data flows over WS after upgrade.
    client_max_body_size 1m;

    # WebSocket upgrade map: turns `Upgrade: websocket` into
    # `Connection: upgrade`.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # CORS preflight (`OPTIONS`) is owned by the relay binary (tower-http).
    # Zero the rate-limit key for preflights so they are proxied through and
    # never throttled — the relay answers them and emits the
    # `Access-Control-*` headers, which nginx passes through unchanged.
    map $request_method $rl_key {
        OPTIONS "";
        default $binary_remote_addr;
    }

    # -----------------------------------------------------------------
    # Rate limit zones.
    #
    # - tunnel:  registration — every tunnel consumes server resources,
    #            so the cap is strict.
    # - version: `/r/:slug/info/version` probes; combined with the relay's
    #            uniform responses, this makes slug enumeration impractical.
    # - session: token submission (`/r/:slug/session` + `/command/login`);
    #            throttles brute-force token guessing.
    # - ws:      WebSocket upgrade attempts; prevents connection flooding.
    # -----------------------------------------------------------------
    limit_req_zone $rl_key zone=tunnel:10m   rate=2r/m;
    limit_req_zone $rl_key zone=version:10m  rate=30r/m;
    limit_req_zone $rl_key zone=session:10m  rate=10r/m;
    limit_req_zone $rl_key zone=ws:10m       rate=20r/m;

    # Per-IP connection cap. Bounds total resource consumption from a
    # single source.
    limit_conn_zone $binary_remote_addr zone=perip:10m;

    # Rate limit response: `429 Too Many Requests` with `Retry-After`.
    limit_req_status 429;
    limit_conn_status 429;

    # Modern TLS settings.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # ------------------------------
    # Port 80: ACME challenge + redirect.
    # ------------------------------
    server {
        listen      80;
        listen [::]:80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ------------------------------
    # Port 443: relay proxy.
    # ------------------------------
    server {
        listen      443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name ${PUBLIC_HOST};

        ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;

        # Clamp concurrent connections per IP. This vhost is transport-only
        # (tunnel + viewer WebSockets + JSON probes).
        limit_conn perip 50;

        # Security headers — defense-in-depth on the JSON responses. No CSP:
        # this origin serves no document, only transport. The browser viewer
        # is served from a separate app origin (out-of-band).
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "DENY" always;
        add_header Referrer-Policy           "no-referrer" always;

        # Tunnel registration: strict limit — every tunnel is a server
        # resource commit.
        location /tunnel/ {
            limit_req zone=tunnel burst=5 nodelay;
            include /etc/nginx/snippets/proxy-ws.conf;
        }

        # Version probe — the only JSON GET the relay serves under a slug.
        # Its uniform response makes slug enumeration impractical.
        location ~ ^/r/[^/]+/info/version$ {
            limit_req zone=version burst=60 nodelay;
            include /etc/nginx/snippets/proxy-ws.conf;
        }

        # Token submission: `session` (both one-shot and cookie-check)
        # and `command/login` are the brute-force-susceptible endpoints.
        location ~ ^/r/[^/]+/(session|command/login)$ {
            limit_req zone=session burst=20 nodelay;
            include /etc/nginx/snippets/proxy-ws.conf;
        }

        # Viewer WebSocket upgrades (terminal + control planes).
        location ~ ^/r/[^/]+/ws/ {
            limit_req zone=ws burst=30 nodelay;
            include /etc/nginx/snippets/proxy-ws.conf;
        }

        # Everything else (health probe, future endpoints) — forwarded
        # transparently. No rate limit.
        location / {
            include /etc/nginx/snippets/proxy-ws.conf;
        }
    }
}
